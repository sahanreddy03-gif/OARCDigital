{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.oarcdigital.com"
        }
      ],
      "destination": "https://oarcdigital.com/$1",
      "permanent": true
    },
    {
      "source": "/case-studies/venturehub-co",
      "destination": "/case-studies",
      "permanent": true
    },
    {
      "source": "/case-studies/apex-fitness-collective",
      "destination": "/case-studies",
      "permanent": true
    },
    {
      "source": "/case-studies/volta-home",
      "destination": "/case-studies",
      "permanent": true
    },
    {
      "source": "/case-studies/phantom-peripherals",
      "destination": "/case-studies",
      "permanent": true
    },
    {
      "source": "/case-studies/riftleague",
      "destination": "/case-studies",
      "permanent": true
    },
    {
      "source": "/case-studies/maison-lumiere",
      "destination": "/case-studies",
      "permanent": true
    },
    {
      "source": "/case-studies/global-supply-systems",
      "destination": "/case-studies",
      "permanent": true
    },
    {
      "source": "/services/ai-content-strategist",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/enterprise",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/ai-consulting",
      "destination": "/services/ai-consulting",
      "permanent": true
    },
    {
      "source": "/case-studies/fitnesspro-network",
      "destination": "/case-studies/apex-fitness-collective",
      "permanent": true
    },
    {
      "source": "/case-studies/homecraft-innovations",
      "destination": "/case-studies/volta-home",
      "permanent": true
    },
    {
      "source": "/case-studies/gamingtech-elite",
      "destination": "/case-studies/phantom-peripherals",
      "permanent": true
    },
    {
      "source": "/case-studies/progamer-network",
      "destination": "/case-studies/riftleague",
      "permanent": true
    },
    {
      "source": "/case-studies/luxe-essence",
      "destination": "/case-studies/maison-lumiere",
      "permanent": true
    },
    {
      "source": "/case-studies/streamflow-automation",
      "destination": "/case-studies",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/agents/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/BingSiteAuth.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "buildCommand": "npm run gate:full && next build && (if [ \"$VERCEL_ENV\" = \"production\" ]; then npx tsx scripts/index-now-ping.ts --delta; else echo \"[postbuild] skipping IndexNow ping (VERCEL_ENV=$VERCEL_ENV)\"; fi)"
}
