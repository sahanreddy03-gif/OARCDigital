{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.oarcdigital.com"
        }
      ],
      "destination": "https://oarcdigital.com/$1",
      "permanent": true
    },
    {
      "source": "/services/ai-content-strategist",
      "destination": "/services/content-marketing",
      "permanent": true
    },
    {
      "source": "/enterprise",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/ai-consulting",
      "destination": "/services/ai-consulting",
      "permanent": true
    },
    {
      "source": "/oarc-digital",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/oarc-digital/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/social-media-agency-malta",
      "destination": "/aeo/social-media-agency-malta",
      "permanent": true
    },
    {
      "source": "/social-media-agency-malta/",
      "destination": "/aeo/social-media-agency-malta",
      "permanent": true
    },
    {
      "source": "/services/ai-business-development",
      "destination": "/services/lead-generation",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/agents/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/BingSiteAuth.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "buildCommand": "bash scripts/vercel-build.sh",
  "framework": "nextjs"
}
