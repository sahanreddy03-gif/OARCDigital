{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.oarcdigital.com"
        }
      ],
      "destination": "https://oarcdigital.com/$1",
      "permanent": true
    },
    {
      "source": "/case-studies/venturehub-co",
      "destination": "/our-work",
      "permanent": true
    },
    {
      "source": "/case-studies/apex-fitness-collective",
      "destination": "/our-work",
      "permanent": true
    },
    {
      "source": "/case-studies/volta-home",
      "destination": "/our-work",
      "permanent": true
    },
    {
      "source": "/case-studies/phantom-peripherals",
      "destination": "/our-work",
      "permanent": true
    },
    {
      "source": "/case-studies/riftleague",
      "destination": "/our-work",
      "permanent": true
    },
    {
      "source": "/case-studies/maison-lumiere",
      "destination": "/our-work",
      "permanent": true
    },
    {
      "source": "/case-studies/global-supply-systems",
      "destination": "/our-work",
      "permanent": true
    },
    {
      "source": "/services/ai-content-strategist",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/enterprise",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/ai-consulting",
      "destination": "/services/ai-consulting",
      "permanent": true
    },
    {
      "source": "/case-studies/fitnesspro-network",
      "destination": "/our-work",
      "permanent": true
    },
    {
      "source": "/case-studies/homecraft-innovations",
      "destination": "/our-work",
      "permanent": true
    },
    {
      "source": "/case-studies/gamingtech-elite",
      "destination": "/our-work",
      "permanent": true
    },
    {
      "source": "/case-studies/progamer-network",
      "destination": "/our-work",
      "permanent": true
    },
    {
      "source": "/case-studies/luxe-essence",
      "destination": "/our-work",
      "permanent": true
    },
    {
      "source": "/case-studies/streamflow-automation",
      "destination": "/our-work",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/agents/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/BingSiteAuth.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "buildCommand": "next build && bash -c 'if [ \"$VERCEL_ENV\" = \"production\" ]; then npx tsx scripts/index-now-ping.ts --delta && npx tsx scripts/verify-indexnow.ts; else echo \"[deploy] VERCEL_ENV=$VERCEL_ENV — skipping IndexNow ping (production-only)\"; fi'",
  "framework": "nextjs"
}
