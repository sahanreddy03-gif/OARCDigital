{
  "include": [
    "shared/**/*",
    "app/**/*",
    "lib/**/*",
    "components/**/*",
    "types/**/*.d.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    ".next",
    "**/*.test.ts"
  ],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "target": "ES2020",
    "strict": true,
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "types": [
      "node"
    ],
    "paths": {
      "@/*": ["./*"],
      "@/components/*": ["./components/*"],
      "@/lib/*": ["./lib/*"],
      "@/shared/*": ["./shared/*"],
      "@shared/*": ["./shared/*"],
      "@/assets/*": ["./lib/assets/*"],
      "@/config/*": ["./lib/config/*"],
      "@/data/*": ["./lib/data/*"],
      "@/hooks/*": ["./lib/hooks/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true
  }
}
