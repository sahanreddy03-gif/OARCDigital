# SEO docs — these live under .local/ (which the system gitignore
# excludes wholesale) but MUST be tracked so the seo-tier-doc /
# framework guide ship with the repo.
!.local/
.local/*
!.local/seo-tier-doc.md
!.local/seo-framework.md
!.local/seo-keyword-map.md
!.local/seo-rollout-calendar.md
!.local/lychee-allowlist.txt
# .local/seo-phrase-blocklist.md is the source-of-truth markdown read at
# module load by lib/seo/phraseBlocklist.ts (which audit-framework imports).
# Must be tracked or Vercel build fails on the very first audit step.
!.local/seo-phrase-blocklist.md
# .local/seo/restore.json holds the kept-slug whitelist used by
# generateStaticParams() in the /malta/[location]/* dynamic routes.
# Must be tracked or Vercel build fails on missing import.
!.local/seo/
!.local/seo/restore.json

